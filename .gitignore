!/outputs/framework_connection_v3/F/
!/outputs/framework_connection_v3/PF/
!/outputs/framework_connection_v3/*/*.json
!/outputs/framework_connection_v3/*/q8_prompt.txt

!/outputs/framework_compact_v1/
