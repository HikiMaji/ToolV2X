# Root allowlist: local models, datasets and new output groups stay outside Git.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/requirements-review.txt
!/src/
!/tests/
!/vendor/
!/scripts/
!/docs/
!/outputs/

__pycache__/
*.py[cod]
.DS_Store

# Research documents are small; paper files and extracted full texts are local.
/docs/papers/*
!/docs/papers/download_manifest.md

# Only the named evidence files/directories below are part of the review tree.
/outputs/**
!/outputs/protocol_audit/
!/outputs/protocol_audit/audit.json
!/outputs/protocol_audit/artifact_validation.json
!/outputs/protocol_audit/split_manifest.json
!/outputs/protocol_audit/train_frames.json
!/outputs/protocol_audit/validation_frames.json
!/outputs/protocol_audit/test_frames.json

!/outputs/framework_connection_v3/
!/outputs/framework_connection_v3/*.json
!/outputs/framework_connection_v3/Ego/
!/outputs/framework_connection_v3/P/
!/outputs/framework_connection_v3/F/
!/outputs/framework_connection_v3/PF/
!/outputs/framework_connection_v3/*/*.json
!/outputs/framework_connection_v3/*/q8_prompt.txt

!/outputs/framework_compact_v1/
!/outputs/framework_compact_v1/*.json
!/outputs/framework_compact_v1/Ego/
!/outputs/framework_compact_v1/P/
!/outputs/framework_compact_v1/F/
!/outputs/framework_compact_v1/PF/
!/outputs/framework_compact_v1/*/*.json
!/outputs/framework_compact_v1/*/q8_prompt.txt

!/outputs/framework_compact_train_v1/
!/outputs/framework_compact_train_v1/*.json
!/outputs/framework_compact_train_v1/Ego/
!/outputs/framework_compact_train_v1/P/
!/outputs/framework_compact_train_v1/F/
!/outputs/framework_compact_train_v1/PF/
!/outputs/framework_compact_train_v1/*/*.json
!/outputs/framework_compact_train_v1/*/q8_prompt.txt

!/outputs/evidence_comparison_v1/
!/outputs/evidence_comparison_v1/*.json
!/outputs/adaptation_data_v1/
!/outputs/adaptation_data_v1/preparation.json
!/outputs/adaptation_data_v1/independent_verification.json
!/outputs/adaptation_data_v1/examples/
!/outputs/adaptation_data_v1/examples/train.jsonl
!/outputs/adaptation_forward_v1/
!/outputs/adaptation_forward_v1/forward_check.json
!/outputs/logs/
!/outputs/logs/verify_compact_adaptation_v1.py
!/outputs/logs/verify_framework_v3.py
!/outputs/logs/compact_adaptation_tests_v1.log

