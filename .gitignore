# Root allowlist: local models, datasets and new output groups stay outside Git.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/requirements-review.txt
!/src/
!/tests/
!/vendor/
!/scripts/
!/docs/
!/outputs/

__pycache__/
*.py[cod]
.DS_Store

# Research documents are small; paper files and extracted full texts are local.
/docs/papers/*
!/docs/papers/download_manifest.md

# Only the named evidence files/directories below are part of the review tree.
/outputs/**
!/outputs/protocol_audit/
!/outputs/protocol_audit/audit.json
!/outputs/protocol_audit/artifact_validation.json
!/outputs/protocol_audit/split_manifest.json
!/outputs/protocol_audit/train_frames.json
!/outputs/protocol_audit/validation_frames.json
